FROM python:3.13-bookworm@sha256:073ffebb96ae4d0ed73ccad59f08c47bd84af8a79f5258130f8458ac50ad9ff4

ARG DOCKER_TAG
ARG DOCKER_COMMIT=docker
ENV DOCKER_TAG=$DOCKER_TAG DOCKER_COMMIT=$DOCKER_COMMIT

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 999 lbry && useradd -m -u 999 -g lbry lbry
WORKDIR /home/lbry/app
COPY --chown=lbry:lbry setup.py setup.cfg README.md LICENSE ./
COPY --chown=lbry:lbry lbry ./lbry
COPY --chown=lbry:lbry docker/set_build.py ./docker/set_build.py
RUN chown lbry:lbry /home/lbry/app
USER lbry
ENV PATH="/home/lbry/.local/bin:$PATH"
RUN python -m pip install --no-cache-dir pip==26.2.1 \
    && python -m pip install --no-cache-dir . \
    && python -m pip check
RUN python docker/set_build.py

COPY docker/webconf.yaml /webconf.yaml
ENTRYPOINT ["lbrynet", "start", "--config=/webconf.yaml"]
